/** User-facing instructions kept beside the help page. No user data is read. */
export class LumiHelpSection {
  id: string;
  title: string;
  caption: string;

  constructor(id: string, title: string, caption: string) {
    this.id = id;
    this.title = title;
    this.caption = caption;
  }
}

export class LumiHelpArticle {
  id: string;
  sectionId: string;
  title: string;
  summary: string;
  steps: string[];
  notes: string[];
  toolId: string;

  constructor(id: string, sectionId: string, title: string, summary: string, steps: string[],
    notes: string[] = [], toolId: string = '') {
    this.id = id;
    this.sectionId = sectionId;
    this.title = title;
    this.summary = summary;
    this.steps = steps;
    this.notes = notes;
    this.toolId = toolId;
  }

  matches(query: string): boolean {
    const keyword: string = query.trim().toLowerCase();
    return keyword.length === 0 || [this.title, this.summary, this.toolId, this.steps.join(' '), this.notes.join(' ')]
      .join(' ').toLowerCase().includes(keyword);
  }
}

